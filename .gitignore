# Build output
/dist/
/build/
/target/
/node_modules/

# The gate's throwaway board, key store and the seed's manifest, if ever made here
/board/
/store/
/store-seed/

# Local scratch; never committed
/_workspace/

# Python's bytecode cache (the harness)
__pycache__/

# Editors and the OS
/.idea/
/.vscode/
.DS_Store

# What the gate writes: regenerated by every run, read locally, never committed
/results/
/shots/
